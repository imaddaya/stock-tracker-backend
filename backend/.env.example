# ---------------------------------------------------------
# Email
# ---------------------------------------------------------

EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_email_app_password


# ---------------------------------------------------------
# JWT authentication
# ---------------------------------------------------------

JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256


# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=stocks

# Use this when running FastAPI directly on your computer.
DATABASE_URL=postgresql://postgres:replace_with_a_strong_database_password@localhost:5432/stocks

# Use this inside Docker Compose.
# "postgres" is the Docker Compose service name.
DOCKER_DATABASE_URL=postgresql://postgres:replace_with_a_strong_database_password@postgres:5432/stocks


# ---------------------------------------------------------
# Frontend
# ---------------------------------------------------------

FRONTEND_URL=http://127.0.0.1:3000


# ---------------------------------------------------------
# Alpha Vantage
# ---------------------------------------------------------

# Optional server-level API key.
# Individual users currently store their own Alpha Vantage API key.
ALPHA_VANTAGE_API_KEY=